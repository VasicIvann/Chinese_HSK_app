# Database URL — Neon Postgres (shared with the Streamlit app during migration)
HSK_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# JWT signing secret. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-with-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=43200  # 30 days

# Anthropic API key for the Expression écrite correction endpoint.
ANTHROPIC_API_KEY=sk-ant-api03-xxx
# Optional: override the Claude model. Default = claude-haiku-4-5-20251001.
# HSK_CLAUDE_MODEL=claude-haiku-4-5-20251001

# CORS origins allowed to call the API, comma-separated.
# Local dev: http://localhost:3000
# Production: https://your-frontend.vercel.app
CORS_ORIGINS=http://localhost:3000,https://hskapp.vercel.app

# Optional invite-only mode: if set, only these emails can register (comma-separated).
# Leave empty to allow open registration (matches the Streamlit behavior).
ALLOWED_REGISTRATION_EMAILS=
