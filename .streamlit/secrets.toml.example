# Copy this file to .streamlit/secrets.toml (local)
# or set the same keys in Streamlit Cloud > App settings > Secrets.

# Neon connection string example:
# HSK_DATABASE_URL = "postgresql://<user>:<password>@<host>/<db>?sslmode=require"
HSK_DATABASE_URL = ""

# Anthropic API key for the Expression écrite correction page.
# Get one at https://console.anthropic.com/ (separate from your Claude Pro/Max subscription).
ANTHROPIC_API_KEY = ""

# Optional: override the Claude model used for corrections.
# Defaults to claude-haiku-4-5-20251001 (cheapest, fast).
# HSK_CLAUDE_MODEL = "claude-haiku-4-5-20251001"
